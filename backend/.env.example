# ==========================================
# PLAN KMAP - CONFIGURACIÓN DEL BACKEND (PHP CI3)
# ==========================================
PORT=4000
CI_ENV=development

# ==========================================
# BASE DE DATOS MYSQL (XAMPP / LOCAL)
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kmap
DB_USER=root
DB_PASS=

# ==========================================
# SEGURIDAD Y JWT
# ==========================================
JWT_SECRET=kmap_secret_jwt_key_2026_super_secure
JWT_EXPIRE=86400

# ==========================================
# SERVICIO DE IA (GEMINI - BITSIBOOT)
# Clave gratis en https://aistudio.google.com/apikey
# ==========================================
AI_API_KEY=tu_api_key_de_gemini
AI_MODEL=gemini-3.8-flash
